{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Copenhagen)",
  ],
  // Merge PR-based updates (action bumps, SHA pins) once the platform allows
  // it. Relies on the repo's "Allow auto-merge" setting; without it Renovate
  // falls back to merging itself. CI runs on every PR (build-images.yml).
  automerge: true,
  automergeType: "pr",
  platformAutomerge: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  // Renovate's nix manager shells out to `nix flake update`; the stock
  // renovate image has no nix binary (and no writable store), so flake.lock
  // bumps are handled by .github/workflows/flake-update.yml instead.
  nix: {
    enabled: false,
  },
}
