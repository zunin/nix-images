{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Copenhagen)",
  ],
  // Merge PR-based updates (action bumps, SHA pins) once the platform allows
  // it. Relies on the repo's "Allow auto-merge" setting; without it Renovate
  // falls back to merging itself. CI runs on every PR (build-images.yml).
  automerge: true,
  automergeType: "pr",
  platformAutomerge: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  // The self-hosted runner (fleet/renovate CronJob) now runs the
  // nix-images-built ghcr.io/zunin/renovate image, which bundles the nix
  // CLI (and git) the manager needs. lockFileMaintenance bumps flake.lock
  // daily; this replaces the deleted .github/workflows/flake-update.yml
  // lane (the stock renovate image has no nix binary).
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [ "nix" ],
      lockFileMaintenance: { enabled: true },
      // Runner cron is @midnight UTC (~01/02:00 local) — inside the window.
      schedule: [ "before 5am" ],
      // Semantic prefix is prepended automatically, so both the commit and
      // the (squash-merge) PR title read "chore(deps): update flake.lock" —
      // the shape the deleted flake-update workflow used.
      commitMessageAction: "update",
      commitMessageTopic: "flake.lock",
    },
  ],
}
